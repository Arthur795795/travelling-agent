{
  "name": "travel-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/unit/*.test.ts",
    "test:integration": "node --test --experimental-strip-types tests/integration/*.test.ts",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "test:eval:fixtures": "node --test --experimental-strip-types tests/eval/fixtures/*.test.ts",
    "test:eval:live": "node --test --experimental-strip-types tests/eval/live/*.test.ts",
    "test:security": "node --test --experimental-strip-types tests/security/*.test.ts",
    "maintenance": "node --experimental-strip-types scripts/maintenance.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.4",
    "typescript": "^6.0.3"
  }
}
