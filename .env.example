# Server-only application key. Never expose it with a NEXT_PUBLIC_ prefix.
AMAP_WEB_SERVICE_KEY=

# DeepSeek keys are supplied per browser session and must never be stored here.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Comma-separated, manually verified official domains; this is not a complete city directory.
OFFICIAL_SOURCE_HOSTS=dpm.org.cn

# Runtime storage
SQLITE_PATH=./data/travel-agent.sqlite

# Feature flags
FEATURE_CUSTOM_GENERATION=false
FEATURE_WEB_SEARCH=false
FEATURE_AMAP=false
FEATURE_SHARING=false
FEATURE_EXPORT=false

# PDF runtime (server only). Use a Chinese-capable TTF/OTF and a Python with reportlab.
PDF_FONT_PATH=
PDF_PYTHON=python3

# Required only for the scheduled maintenance command; exactly 32 bytes after base64 decoding.
BACKUP_ENCRYPTION_KEY_BASE64=

# Compliance fields stay hidden behind verified flags until independently checked.
MODEL_REGISTRATION_VERIFIED=false
MODEL_REGISTRATION_ID=
MODEL_LAUNCH_VERIFIED=false
MODEL_LAUNCH_ID=
