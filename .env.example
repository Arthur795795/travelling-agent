# Server-only application key. Never expose it with a NEXT_PUBLIC_ prefix.
AMAP_WEB_SERVICE_KEY=
# Optional server-only HTTP(S) proxy used only for Amap Web Service requests.
# Leave empty for direct connections and never commit proxy credentials.
AMAP_HTTPS_PROXY=

# DeepSeek keys are supplied per browser session and must never be stored here.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional server-only HTTP(S) proxy for DeepSeek requests. Leave empty for
# direct connections. Never use a NEXT_PUBLIC_ name or commit proxy credentials.
DEEPSEEK_HTTPS_PROXY=
# Server-side Key validation deadline (1,000–120,000 ms). The default avoids
# treating a normally queued V4 Pro streaming response as a 6-second failure.
DEEPSEEK_KEY_VALIDATION_TIMEOUT_MS=30000
# Server-side deadline for each formal DeepSeek response (30,000–600,000 ms).
DEEPSEEK_RESPONSE_TIMEOUT_MS=300000
# Server-side deadline for the complete planning job (60,000–1,800,000 ms).
PLANNING_TASK_TIMEOUT_MS=900000

# Comma-separated, manually verified official domains; this is not a complete city directory.
OFFICIAL_SOURCE_HOSTS=dpm.org.cn

# Runtime storage
SQLITE_PATH=./data/travel-agent.sqlite

# Feature flags. A real custom plan requires all first three to be true.
FEATURE_CUSTOM_GENERATION=false
FEATURE_WEB_SEARCH=false
FEATURE_AMAP=false
FEATURE_SHARING=false
FEATURE_EXPORT=false
FEATURE_OFFLINE_READONLY=false

# Optional fail-closed model regression state generated by `npm run model:regression`.
MODEL_REGRESSION_STATE_PATH=

# Explicitly controlled internal evaluation only; never use visitor credentials.
LIVE_EVAL_ENABLED=false
INTERNAL_DEEPSEEK_EVAL_KEY=
LIVE_EVAL_MAX_CASES=2
LIVE_EVAL_MAX_STEPS=12
LIVE_EVAL_MAX_COST_CNY=2
LIVE_EVAL_REPORT_DIR=./reports/live

# Public case-study report. Fixed reports must remain labelled as non-live.
EVAL_PUBLIC_REPORT_FILE=eval-fixtures.json

# PDF runtime (server only). Use a Chinese-capable TTF/OTF and a Python with reportlab.
PDF_FONT_PATH=
PDF_PYTHON=python3

# Required only for the scheduled maintenance command; exactly 32 bytes after base64 decoding.
BACKUP_ENCRYPTION_KEY_BASE64=

# Compliance fields stay hidden behind verified flags until independently checked.
MODEL_REGISTRATION_VERIFIED=false
MODEL_REGISTRATION_ID=
MODEL_LAUNCH_VERIFIED=false
MODEL_LAUNCH_ID=
